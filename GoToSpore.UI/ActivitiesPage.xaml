<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:GoToSpore.UI"
             x:Class="GoToSpore.UI.ActivitiesPage"
             Title="Activities"
             BackgroundColor="#FFFFFF"
             Shell.NavBarIsVisible="False"
             FlowDirection="LeftToRight">

    <Grid RowDefinitions="*, Auto">

        <!-- Main Content Area -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- Header Title Section -->
                <VerticalStackLayout Spacing="4" Margin="0,10,0,0">
                    <Label Text="Weekly Challenges"
                           TextColor="#333333"
                           FontSize="24"
                           FontAttributes="Bold" />
                    <Label Text="Select a challenge to track your performance"
                           TextColor="#333333"
                           Opacity="0.7"
                           FontSize="14" />
                </VerticalStackLayout>

                <!-- 1. Weekly Running Challenge (20 KM / Week) -->
                <Border BackgroundColor="#FFFFFF"
                        Stroke="#F97316"
                        StrokeThickness="1.5"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                            <Path Grid.Column="0"
                                  Data="M13.5 5.5c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zM9.8 8.9L7 23h2.1l1.8-8 2.1 2v6h2v-7.5l-2.1-2 .6-3C14.8 12 16.8 13 19 13v-2c-1.9 0-3.5-1-4.3-2.4l-1-1.6c-.4-.6-1-1-1.7-1-.3 0-.5.1-.8.1L6 8.3V13h2V9.6l1.8-.7z"
                                  Fill="#F97316"
                                  Aspect="Uniform"
                                  HeightRequest="24"
                                  WidthRequest="24"
                                  VerticalOptions="Center" />

                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Weekly Run Challenge"
                                       TextColor="#333333"
                                       FontSize="16"
                                       FontAttributes="Bold" />
                                <Label Text="Cover 20 km within 7 days"
                                       TextColor="#333333"
                                       Opacity="0.7"
                                       FontSize="13" />
                            </VerticalStackLayout>

                            <Border Grid.Column="2"
                                    BackgroundColor="#FFFFFF"
                                    Stroke="#F97316"
                                    StrokeThickness="1"
                                    Padding="8,4">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Label Text="4 Days Left"
                                       TextColor="#F97316"
                                       FontSize="11"
                                       FontAttributes="Bold" />
                            </Border>
                        </Grid>

                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0"
                                       x:Name="LblRunProgressText"
                                       Text="Progress: 0.00 km / 20 km"
                                       TextColor="#333333"
                                       FontSize="13" />
                                <Label Grid.Column="1"
                                       x:Name="LblRunPercentage"
                                       Text="0%"
                                       TextColor="#F97316"
                                       FontSize="13"
                                       FontAttributes="Bold" />
                            </Grid>

                            <ProgressBar x:Name="ProgressRun"
                                         Progress="0.0"
                                         ProgressColor="#F97316"
                                         BackgroundColor="#333333"
                                         HeightRequest="8" />
                        </VerticalStackLayout>

                        <Button x:Name="BtnToggleRunChallenge"
                                Text="Start Challenge"
                                BackgroundColor="#F97316"
                                TextColor="#FFFFFF"
                                FontAttributes="Bold"
                                CornerRadius="10"
                                HeightRequest="45"
                                Clicked="OnToggleRunChallengeClicked" />
                    </VerticalStackLayout>
                </Border>

                <!-- 2. Calorie Burner Challenge -->
                <Border BackgroundColor="#FFFFFF"
                        Stroke="#333333"
                        StrokeThickness="1"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                            <Path Grid.Column="0"
                                  Data="M13.5 1.5c0 0-2.5 3.5-2.5 6 0 1.4.6 2.6 1.5 3.5.3-1 .1-2.2-.5-3.1 2.5 1.2 4.5 3.7 4.5 6.6 0 3.9-3.1 7-7 7s-7-3.1-7-7c0-4.3 3.3-8 7-9.8.7 1.2 1.8 2.2 3.1 2.7-.2-2-.9-4.1-2.2-5.9z"
                                  Fill="#333333"
                                  Aspect="Uniform"
                                  HeightRequest="24"
                                  WidthRequest="24"
                                  VerticalOptions="Center" />

                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Calorie Burner"
                                       TextColor="#333333"
                                       FontSize="16"
                                       FontAttributes="Bold" />
                                <Label Text="Burn 3,000 kcal active energy"
                                       TextColor="#333333"
                                       Opacity="0.7"
                                       FontSize="13" />
                            </VerticalStackLayout>

                            <Border Grid.Column="2"
                                    BackgroundColor="#FFFFFF"
                                    Stroke="#333333"
                                    StrokeThickness="1"
                                    Padding="8,4">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Label Text="In Progress"
                                       TextColor="#333333"
                                       FontSize="11"
                                       FontAttributes="Bold" />
                            </Border>
                        </Grid>

                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0"
                                       x:Name="LblCalorieProgressText"
                                       Text="Progress: 0 / 3,000 kcal"
                                       TextColor="#333333"
                                       FontSize="13" />
                                <Label Grid.Column="1"
                                       x:Name="LblCaloriePercentage"
                                       Text="0%"
                                       TextColor="#333333"
                                       FontSize="13"
                                       FontAttributes="Bold" />
                            </Grid>

                            <ProgressBar x:Name="ProgressCalorie"
                                         Progress="0.0"
                                         ProgressColor="#F97316"
                                         BackgroundColor="#333333"
                                         HeightRequest="8" />
                        </VerticalStackLayout>

                        <Button x:Name="BtnToggleCalorieChallenge"
                                Text="Start Challenge"
                                BackgroundColor="#FFFFFF"
                                TextColor="#333333"
                                BorderColor="#333333"
                                BorderWidth="1"
                                FontAttributes="Bold"
                                CornerRadius="10"
                                HeightRequest="45"
                                Clicked="OnToggleCalorieChallengeClicked" />
                    </VerticalStackLayout>
                </Border>

                <!-- 3. Walk Challenge -->
                <Border BackgroundColor="#FFFFFF"
                        Stroke="#333333"
                        StrokeThickness="1"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                            <Path Grid.Column="0"
                                  Data="M13.5 5.5c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zM9.8 8.9L7 23h2.1l1.8-8 2.1 2v6h2v-7.5l-2.1-2 .6-3C14.8 12 16.8 13 19 13v-2c-1.9 0-3.5-1-4.3-2.4l-1-1.6c-.4-.6-1-1-1.7-1-.3 0-.5.1-.8.1L6 8.3V13h2V9.6l1.8-.7z"
                                  Fill="#333333"
                                  Aspect="Uniform"
                                  HeightRequest="24"
                                  WidthRequest="24"
                                  VerticalOptions="Center" />

                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="50K Steps Challenge"
                                       TextColor="#333333"
                                       FontSize="16"
                                       FontAttributes="Bold" />
                                <Label Text="Outdoor walking target for 7 days"
                                       TextColor="#333333"
                                       Opacity="0.7"
                                       FontSize="13" />
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0"
                                       x:Name="LblWalkProgressText"
                                       Text="Progress: 0 / 50,000 Steps"
                                       TextColor="#333333"
                                       FontSize="13" />
                                <Label Grid.Column="1"
                                       x:Name="LblWalkPercentage"
                                       Text="0%"
                                       TextColor="#333333"
                                       FontSize="13"
                                       FontAttributes="Bold" />
                            </Grid>

                            <ProgressBar x:Name="ProgressWalk"
                                         Progress="0.0"
                                         ProgressColor="#F97316"
                                         BackgroundColor="#333333"
                                         HeightRequest="8" />
                        </VerticalStackLayout>

                        <Button x:Name="BtnToggleWalkChallenge"
                                Text="Start Challenge"
                                BackgroundColor="#FFFFFF"
                                TextColor="#333333"
                                BorderColor="#333333"
                                BorderWidth="1"
                                FontAttributes="Bold"
                                CornerRadius="10"
                                HeightRequest="45"
                                Clicked="OnToggleWalkChallengeClicked" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Custom Navigation Bar -->
        <controls:CustomNavBar Grid.Row="1" ActiveTab="Activities" FlowDirection="LeftToRight" />

    </Grid>
</ContentPage>