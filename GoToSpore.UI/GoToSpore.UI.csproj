<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- استهداف أندرويد فقط -->
        <TargetFrameworks>net8.0-android</TargetFrameworks>

        <!-- مسارات Android SDK و Java JDK على بيئة Linux -->
        <AndroidSdkDirectory>$(HOME)/Android/Sdk</AndroidSdkDirectory>
        <JavaSdkDirectory>/usr/lib/jvm/java-17-openjdk-amd64</JavaSdkDirectory>

        <OutputType>Exe</OutputType>
        <RootNamespace>GoToSpore.UI</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- Display name -->
        <ApplicationTitle>GoToSpore</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.companyname.gotospore.ui</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <!-- إصدار Android المدعوم -->
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon: استخدام مقياس 0.65 يناسب Safe Zone في أندرويد لعدم قص الأيقونة -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" 
                  ForegroundFile="Resources\AppIcon\appiconfg.svg" 
                  Color="#F06A17" 
                  ForegroundScale="0.65" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" 
                           Color="#F06A17" 
                           BaseSize="128,128" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />
        <!-- تضمين باقي الصور الموجودة في مجلد AppIcon لاستخدامها كصور عادية -->
        <MauiImage Include="Resources\AppIcon\*" Exclude="Resources\AppIcon\appicon.svg;Resources\AppIcon\appiconfg.svg" />
        <MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Maui" Version="9.0.0" />
        <PackageReference Include="CommunityToolkit.Maui.Camera" Version="1.0.2" />
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
    </ItemGroup>

</Project>