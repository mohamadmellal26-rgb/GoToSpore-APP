<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GoToSpore.UI.LoginPage"
             Title="GoToSpore - Account"
             BackgroundColor="#FFFFFF"
             FlowDirection="LeftToRight">

    <Grid RowDefinitions="Auto, *">

        <!-- Top Header Image -->
        <Image Grid.Row="0"
               Source="images.jpeg"
               HeightRequest="180"
               Aspect="AspectFill"
               HorizontalOptions="FillAndExpand"
               VerticalOptions="Start" />

        <!-- Main Scrollable Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="25,20,25,30" Spacing="15" VerticalOptions="Center">

                <!-- Application Title -->
                <Label Text="GoToSpore" 
                       TextColor="#F97316" 
                       FontSize="32" 
                       FontAttributes="Bold" 
                       HorizontalOptions="Center" />

                <Label x:Name="TxtTitle" 
                       Text="Log in to your account" 
                       TextColor="#333333" 
                       Opacity="0.7"
                       FontSize="14" 
                       HorizontalOptions="Center" 
                       Margin="0,0,0,5" />

                <!-- Profile Picture Selection (Modern Avatar Picker) -->
                <VerticalStackLayout x:Name="LayoutAvatarSelection" IsVisible="False" Spacing="6" HorizontalOptions="Center" Margin="0,5">
                    <Grid HeightRequest="100" WidthRequest="100" HorizontalOptions="Center">
                        <!-- Main Circle Avatar Preview -->
                        <Border StrokeThickness="2"
                                Stroke="#F97316"
                                HeightRequest="96"
                                WidthRequest="96"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                BackgroundColor="#FAFAFA">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="48" />
                            </Border.StrokeShape>
                            <Image x:Name="ImgAvatarPreview"
                                   Source="appiconfg.png"
                                   Aspect="AspectFill"
                                   HeightRequest="92"
                                   WidthRequest="92" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPickAvatarTapped" />
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- Camera Icon Overlay Badge -->
                        <Border BackgroundColor="#F97316"
                                StrokeThickness="2"
                                Stroke="#FFFFFF"
                                HeightRequest="32"
                                WidthRequest="32"
                                HorizontalOptions="End"
                                VerticalOptions="End"
                                Margin="0,0,2,2">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Label Text="📷"
                                   FontSize="13"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPickAvatarTapped" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>

                    <Label Text="Tap to choose profile photo"
                           TextColor="#F97316"
                           FontSize="12"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Full Name (Register Mode Only) -->
                <VerticalStackLayout x:Name="LayoutFullName" IsVisible="False" Spacing="5">
                    <Label Text="Full Name" 
                           TextColor="#333333" 
                           FontSize="13" 
                           FontAttributes="Bold" />
                    <Border StrokeThickness="1" 
                            Stroke="#333333" 
                            BackgroundColor="#FFFFFF" 
                            Padding="12,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Entry x:Name="TxtFullName" 
                               HeightRequest="45" 
                               BackgroundColor="Transparent" 
                               TextColor="#333333" 
                               Placeholder="Enter your full name"
                               PlaceholderColor="#9CA3AF"
                               FontSize="14" />
                    </Border>
                </VerticalStackLayout>

                <!-- Username -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Username" 
                           TextColor="#333333" 
                           FontSize="13" 
                           FontAttributes="Bold" />

                    <Border StrokeThickness="1" 
                            Stroke="#333333" 
                            BackgroundColor="#FFFFFF" 
                            Padding="12,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Entry x:Name="TxtUsername" 
                               HeightRequest="45" 
                               BackgroundColor="Transparent" 
                               TextColor="#333333" 
                               Placeholder="Enter username"
                               PlaceholderColor="#9CA3AF"
                               FontSize="14" />
                    </Border>
                </VerticalStackLayout>

                <!-- Password -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Password" 
                           TextColor="#333333" 
                           FontSize="13" 
                           FontAttributes="Bold" />

                    <Border StrokeThickness="1" 
                            Stroke="#333333" 
                            BackgroundColor="#FFFFFF" 
                            Padding="12,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Entry x:Name="TxtPassword" 
                               IsPassword="True" 
                               HeightRequest="45" 
                               BackgroundColor="Transparent" 
                               TextColor="#333333" 
                               Placeholder="Enter password"
                               PlaceholderColor="#9CA3AF"
                               FontSize="14" />
                    </Border>
                </VerticalStackLayout>

                <!-- Primary Button -->
                <Button x:Name="BtnSubmit" 
                        Text="Log In" 
                        HeightRequest="48" 
                        BackgroundColor="#F97316" 
                        TextColor="White" 
                        FontAttributes="Bold" 
                        FontSize="15" 
                        CornerRadius="8"
                        Margin="0,10,0,0"
                        Clicked="BtnSubmit_Click" />

                <!-- Toggle Mode Button -->
                <Button x:Name="BtnToggleMode" 
                        Text="Don't have an account? Sign Up" 
                        BackgroundColor="Transparent" 
                        TextColor="#333333" 
                        Opacity="0.7"
                        FontSize="13"
                        Clicked="BtnToggleMode_Click" />

                <!-- Activity Indicator -->
                <ActivityIndicator x:Name="LoadingBar" 
                                   IsRunning="False" 
                                   IsVisible="False" 
                                   Color="#F97316" 
                                   HeightRequest="30" />

                <!-- Status Messages -->
                <Label x:Name="TxtStatus" 
                       Text="" 
                       TextColor="#EF4444" 
                       FontSize="13" 
                       HorizontalOptions="Center" 
                       LineBreakMode="WordWrap" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>