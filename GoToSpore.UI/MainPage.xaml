<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:GoToSpore.UI"
             x:Class="GoToSpore.UI.MainPage"
             x:Name="thisPage"
             Title="GoToSpore Tracker"
             FlowDirection="LeftToRight"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#FFFFFF">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- Top Bar / Header -->
        <Grid Grid.Row="0" BackgroundColor="#FFFFFF">
            <VerticalStackLayout>
                <Grid ColumnDefinitions="*, Auto" Padding="20,16,20,16">
                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                        <Label Text="GoToSpore"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="#333333" />
                        <Label Text="Track your daily activity"
                               FontSize="13"
                               TextColor="#333333"
                               Opacity="0.7" />
                    </VerticalStackLayout>

                    <!-- Sensor Status Badge -->
                    <Border Grid.Column="1"
                            BackgroundColor="#FFFFFF"
                            Stroke="#F97316"
                            StrokeThickness="1"
                            Padding="10,6"
                            HorizontalOptions="End"
                            VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSensorStatusTapped" />
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Path Data="M12 3c-4.97 0-9 4.03-9 9 0 2.12.74 4.07 1.97 5.61L4.35 19.03C2.89 17.12 2 14.66 2 12c0-5.52 4.48-10 10-10s10 4.48 10 10c0 2.66-.89 5.12-2.35 7.03l-1.38-1.42C19.26 16.07 20 14.12 20 12c0-4.97-4.03-9-9-9zm0 4c-2.76 0-5 2.24-5 5 0 1.25.46 2.39 1.22 3.28l1.42-1.42C9.23 13.38 9 12.71 9 12c0-1.66 1.34-3 3-3s3 1.34 3 3c0 .71-.23 1.38-.64 1.86l1.42 1.42C16.54 14.39 17 13.25 17 12c0-2.76-2.24-5-5-5zm0 3c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"
                                  Fill="#F97316"
                                  WidthRequest="16"
                                  HeightRequest="16"
                                  Aspect="Uniform"
                                  VerticalOptions="Center"/>
                            <Label x:Name="SensorStatusLabel"
                                   Text="Sensor Active"
                                   FontSize="11"
                                   TextColor="#F97316"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   LineBreakMode="NoWrap" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <BoxView HeightRequest="2" Color="#F97316" HorizontalOptions="Fill" />
            </VerticalStackLayout>
        </Grid>

        <!-- Scrollable Content -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- Main Tracker Card -->
                <Border BackgroundColor="#FFFFFF"
                        Stroke="#F97316"
                        StrokeThickness="1.5"
                        Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="20" HorizontalOptions="Center">

                        <!-- Main Counter Ring -->
                        <Grid WidthRequest="220" HeightRequest="220" HorizontalOptions="Center">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCounterTapped" />
                            </Grid.GestureRecognizers>

                            <Ellipse WidthRequest="210"
                                     HeightRequest="210"
                                     Stroke="#333333"
                                     StrokeThickness="8"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"/>

                            <Ellipse WidthRequest="210"
                                     HeightRequest="210"
                                     StrokeThickness="8"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                                <Ellipse.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#F97316" Offset="0.0" />
                                        <GradientStop Color="#FB923C" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Ellipse.Stroke>
                            </Ellipse>

                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                                <Path Data="M 12 2 C 8.13 2 5 5.13 5 9 C 5 14.25 12 22 12 22 C 12 22 19 14.25 19 9 C 19 5.13 15.87 2 12 2 Z M 12 11.5 C 10.62 11.5 9.5 10.38 9.5 9 C 9.5 7.62 10.62 6.5 12 6.5 C 13.38 6.5 14.5 7.62 14.5 9 C 14.5 10.38 13.38 11.5 12 11.5 Z"
                                      Fill="#F97316"
                                      WidthRequest="22"
                                      HeightRequest="22"
                                      Aspect="Uniform"
                                      HorizontalOptions="Center" />

                                <Label Text="Distance in Meters"
                                       FontSize="12"
                                       TextColor="#333333"
                                       Opacity="0.7"
                                       HorizontalOptions="Center" />
                                
                                <Label x:Name="MetersLabel"
                                       Text="0 m"
                                       FontSize="34"
                                       FontAttributes="Bold"
                                       TextColor="#333333"
                                       HorizontalOptions="Center" />

                                <BoxView HeightRequest="1" WidthRequest="100" Color="#333333" Opacity="0.2" Margin="0,4" HorizontalOptions="Center"/>

                                <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                                    <Label x:Name="KmLabel"
                                           Text="0.00"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="#F97316" />
                                    <Label Text="km"
                                           FontSize="14"
                                           TextColor="#333333"
                                           Opacity="0.7" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Total Steps Info Box -->
                        <Border BackgroundColor="#FFFFFF"
                                Stroke="#333333"
                                StrokeThickness="1"
                                Padding="16,12"
                                HorizontalOptions="Fill">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                <Path Grid.Column="0"
                                      Data="M 13.5 5.5 C 14.6 5.5 15.5 4.6 15.5 3.5 C 15.5 2.4 14.6 1.5 13.5 1.5 C 12.4 1.5 11.5 2.4 11.5 3.5 C 11.5 4.6 12.4 5.5 13.5 5.5 Z M 9.8 8.9 L 7 23 H 9.1 L 11.3 13 L 13 15 V 23 H 15 V 13.8 L 12.9 11.7 L 13.5 8.8 C 14.7 10.2 16.5 11.2 18.6 11.4 V 9.4 C 16.8 9.2 15.3 8.1 14.6 6.6 L 13.6 5.1 C 13.2 4.5 12.5 4.1 11.7 4.1 C 11.4 4.1 11.1 4.2 10.8 4.3 L 6 6.3 V 11 H 8 V 7.8 L 9.8 8.9 Z"
                                      Fill="#F97316"
                                      WidthRequest="20"
                                      HeightRequest="20"
                                      Aspect="Uniform"
                                      VerticalOptions="Center" />

                                <Label Grid.Column="1" 
                                       Text="Total Steps" 
                                       TextColor="#333333" 
                                       FontSize="14" 
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"/>
                                <Label Grid.Column="2" 
                                       x:Name="StepsLabel" 
                                       Text="0" 
                                       TextColor="#F97316" 
                                       FontSize="18" 
                                       FontAttributes="Bold" 
                                       VerticalOptions="Center"/>
                            </Grid>
                        </Border>

                    </VerticalStackLayout>
                </Border>

                <!-- Daily Goals Section Title -->
                <Label Text="Daily Goals"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#333333"
                       Margin="0,4,0,0"/>

                <!-- Running Goal Card (5km) -->
                <Border BackgroundColor="#FFFFFF" 
                        Stroke="#333333" 
                        StrokeThickness="1" 
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="🏃 Running (5 km Target)" TextColor="#333333" FontAttributes="Bold" FontSize="14"/>
                            <Label Grid.Column="1" x:Name="RunGoalLabel" Text="0.00 / 5.0 km" TextColor="#F97316" FontAttributes="Bold" FontSize="13"/>
                        </Grid>
                        <ProgressBar x:Name="RunProgressBar" 
                                     Progress="0.0" 
                                     ProgressColor="#F97316" 
                                     BackgroundColor="#333333"
                                     HeightRequest="8"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Walking Time Goal Card (30 Minutes) -->
                <Border BackgroundColor="#FFFFFF" 
                        Stroke="#333333" 
                        StrokeThickness="1" 
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="🚶 Walking Time (30 min Target)" TextColor="#333333" FontAttributes="Bold" FontSize="14"/>
                            <Label Grid.Column="1" x:Name="WalkGoalLabel" Text="0 / 30 min" TextColor="#333333" FontAttributes="Bold" FontSize="13"/>
                        </Grid>
                        <ProgressBar x:Name="WalkProgressBar" 
                                     Progress="0.0" 
                                     ProgressColor="#F97316" 
                                     BackgroundColor="#333333"
                                     HeightRequest="8"/>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Custom Bottom Navigation Bar -->
        <controls:CustomNavBar Grid.Row="2" ActiveTab="Home" FlowDirection="LeftToRight" />

    </Grid>

</ContentPage>